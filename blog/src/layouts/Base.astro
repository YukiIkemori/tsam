---
import '@fontsource-variable/jost/wght.css';
import '@www/styles/global.css';
import '../styles/blog.css';
import Logo from '@www/components/Logo.astro';
import { site } from '../data/site';
import jost from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  path?: string;
  jsonld?: unknown;
  noindex?: boolean;
  image?: string; // SNS 用の画像（記事のアイキャッチ）。無ければブログ共通のカード
  article?: { published: string; modified: string; section?: string };
  tweet?: boolean;
}
const { title, description = site.description, path = '/', jsonld, noindex = false, image, article, tweet = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const og = new URL(image ?? '/ogp.jpg', site.url).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}>
{!noindex && <link rel="canonical" href={canonical}>}
<link rel="preload" href={jost} as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#f0f0ee">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:site_name" content={site.name}>
<meta property="og:type" content={article ? 'article' : 'website'}>
<meta property="og:locale" content="ja_JP">
{article && <meta property="article:published_time" content={article.published}>}
{article && <meta property="article:modified_time" content={article.modified}>}
{article?.section && <meta property="article:section" content={article.section}>}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={og}>
{!image && <meta property="og:image:width" content="1200">}
{!image && <meta property="og:image:height" content="630">}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={og}>
<link rel="alternate" type="application/rss+xml" href="/feed.xml" title={site.name}>
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@300;400;500&display=swap">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<script is:inline>document.documentElement.classList.add('js');</script>
{site.ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga}`}></script>}
{site.ga && <script is:inline define:vars={{ ga: site.ga }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',ga);</script>}
</head>
<body class="blog">
<header class="top">
  <a class="logo" href="/" aria-label="tsam.blog トップへ"><Logo /><span class="logo__sub" aria-hidden="true">.blog</span></a>
  <nav class="nav" aria-label="メニュー">
    <a href="/archives">Articles</a>
    <a href="/#topics">Topics</a>
    <a href={`${site.home}/`}>tsam<span aria-hidden="true">↗</span></a>
  </nav>
</header>
<main>
  <slot />
</main>
<footer class="foot">
  <div class="foot__bar">
    <ul class="foot__links">
      {site.social.map((s) => <li><a href={s.href} rel="noopener">{s.label}<span aria-hidden="true">↗</span></a></li>)}
      <li><a href="/feed.xml">RSS</a></li>
      <li><a href={`${site.home}/#contact`}>Contact<span aria-hidden="true">↗</span></a></li>
      <li><a href={`${site.home}/pages/privacy-policy`}>Privacy Policy<span aria-hidden="true">↗</span></a></li>
    </ul>
    <p class="foot__copy">© {year} 株式会社tsam</p>
  </div>
  <a class="foot__mark" href="/" aria-label="tsam.blog トップへ"><Logo /><span class="logo__sub display" aria-hidden="true">.blog</span></a>
</footer>
<i class="traveler" aria-hidden="true"></i>
<script>
  import '@www/scripts/ring.js';
  import '@www/scripts/reveal.js';
</script>
{tweet && <script is:inline async src="https://platform.x.com/widgets.js" charset="utf-8"></script>}
</body>
</html>
