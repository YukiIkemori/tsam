---
import Base from '../layouts/Base.astro';
import Fit from '@www/components/Fit.astro';
import Go from '@www/components/Go.astro';
---
<Base title="ページが見つかりません｜tsam.blog" path="/404" noindex>
  <article class="page">
    <header class="page__head">
      <p class="tag"><b>404</b><span>ページが見つかりません</span></p>
      <h1 aria-label="Not found"><Fit word="N|t found" swell /></h1>
    </header>
    <div class="prose">
      <p>お探しのページは、移動したか、なくなった可能性があります。</p>
      <a class="back" href="/archives"><Go />記事一覧へ</a>
    </div>
  </article>
</Base>
