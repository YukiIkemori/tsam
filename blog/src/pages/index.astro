---
import Base from '../layouts/Base.astro';
import O from '@www/components/O.astro';
import { fitStyle } from '@www/lib/fit';
import PostList from '../components/PostList.astro';
import Author from '../components/Author.astro';
import { site, author, org } from '../data/site';
import { posts, usedTags, firstYear, lastYear, abs } from '../lib/posts';

// ブログの表紙。大きな字は「Blog」（公式サイトの最後にある扉「Blog ↗」と同じ語。扉を開けた先に同じ字がある）。
const latest = posts.slice(0, site.latestCount);

// title は30全角以内、description は90〜125全角。頁に見えている事実だけで書く。
const title = 'tsam.blog｜起業家に向けたチップスとコラム';
const description = `株式会社tsamのブログ。起業家に向けたチップス、コラムなど。${usedTags.slice(0, 5).map((t) => t.ja).join('、')}の記事を、代表の池森裕毅が書いています。${firstYear}年から${lastYear}年までの全${posts.length}本。`;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      alternateName: '株式会社tsamブログ',
      description: site.description,
      inLanguage: 'ja',
      publisher: { '@id': org.id },
    },
    {
      '@type': 'Blog',
      '@id': `${site.url}/#blog`,
      url: `${site.url}/`,
      name: site.name,
      description: site.description,
      inLanguage: 'ja',
      publisher: { '@type': 'Organization', '@id': org.id, name: org.name, url: org.url, logo: org.logo },
      author: { '@type': 'Person', '@id': author.id, name: author.name, url: author.url },
      blogPost: latest.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: abs(p.url), datePublished: p.date })),
    },
  ],
};
---
<Base title={title} description={description} path="/" jsonld={jsonld}>

  <section class="hero bhero" id="top">
    <h1 class="display fit bhero__title" style={fitStyle('Blog')} data-swell><span class="vh">tsam.</span>Bl<O hero />g</h1>
    <div class="hero__foot">
      <p class="hero__lead">起業家に向けた<wbr>チップス、<wbr>コラムなど。</p>
      <p class="tag hero__place"><b>{posts.length} articles</b><span>{firstYear}–{lastYear}</span></p>
      <a class="tag hero__next" href="#posts"><b>Latest</b><span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <div class="sec bsec">
    <section class="split split--sub split--first" id="posts">
      <h2 class="sub rv"><span class="display" data-swell>P<O />sts</span><small>最新の記事</small></h2>
      <div>
        <PostList items={latest} excerpt />
        <a class="more more--all" href="/archives">すべての記事を見る<small>{posts.length}本</small><span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="split split--sub" id="topics">
      <h2 class="sub rv"><span class="display" data-swell>T<O />pics</span><small>タグ</small></h2>
      <ul class="topics rv">
        {usedTags.map((t) => (
          <li><a href={`/tags/${t.slug}`}><span class="topics__ja">{t.ja}</span><span class="topics__en display">{t.en.replace('|', 'o')}</span><span class="topics__n">{t.posts.length}</span></a></li>
        ))}
      </ul>
    </section>
  </div>

  <Author />

</Base>
