---
import Base from '../layouts/Base.astro';
import Fit from '@www/components/Fit.astro';
import Go from '@www/components/Go.astro';
import PostList from '../components/PostList.astro';
import Author from '../components/Author.astro';
import { measure, fitVars, HEAVY } from '@www/lib/fit';
import { site, author, org } from '../data/site';
import { posts, usedTags, firstYear, lastYear, abs } from '../lib/posts';

// ブログの表紙。大きな字は「Blog」（公式サイトの最後にある扉「Blog ↗」と同じ語。扉を開けた先に同じ字がある）。
const latest = posts.slice(0, site.latestCount);

// 表紙の字の壁。横長の画面では「Blog」を一行で、縦長の画面では「Bl / og」の二行で、どちらも幅いっぱいに組む。
// 一行と二行を同じ字（同じ要素）で組み替えるので、二つのかけら（Bl と og）それぞれの実測と、一行にしたときの実測を渡す。
//   --I  … 一行にしたときの墨の幅 ／ --r1 … そのときの高さ ÷ 幅
//   --ra・--rb … 二行にしたときの、それぞれの行の高さ ÷ 幅
//   --D1・--D4 … 一行のとき、輪より前の字（Bl）が極細・並の太さでどれだけ短いか（輪を動かさずに太らせるため）
const one = measure('Bl|g', HEAVY);
const a = measure('Bl', HEAVY);
const b = measure('|g', HEAVY);
const v = Object.fromEntries(fitVars('Bl|g', HEAVY).split(';').map((x) => x.split(':')));
const r = (n: number) => String(Math.round(n * 10000) / 10000);
const wall = [
  `--I:${r(one.ink)}`,
  `--r1:${r((one.top + one.bot) / one.ink)}`,
  `--ra:${r((a.top + a.bot) / a.ink)}`,
  `--rb:${r((b.top + b.bot) / b.ink)}`,
  `--D1:${v['--d1']}`,
  `--D4:${v['--d4']}`,
].join(';');
const no = (i: number) => String(i + 1).padStart(2, '0');

// title は30全角以内、description は90〜125全角。頁に見えている事実だけで書く。
const title = 'tsam.blog｜起業家に向けたチップスとコラム';
const description = `株式会社tsamのブログ。起業家に向けたチップス、コラムなど。${usedTags.slice(0, 5).map((t) => t.ja).join('、')}の記事を、代表の池森裕毅が書いています。${firstYear}年から${lastYear}年までの全${posts.length}本。`;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      alternateName: '株式会社tsamブログ',
      description: site.description,
      inLanguage: 'ja',
      publisher: { '@id': org.id },
    },
    {
      '@type': 'Blog',
      '@id': `${site.url}/#blog`,
      url: `${site.url}/`,
      name: site.name,
      description: site.description,
      inLanguage: 'ja',
      publisher: { '@type': 'Organization', '@id': org.id, name: org.name, url: org.url, logo: org.logo },
      author: { '@type': 'Person', '@id': author.id, name: author.name, url: author.url },
      blogPost: latest.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: abs(p.url), datePublished: p.date })),
    },
  ],
};
---
<Base title={title} description={description} path="/" jsonld={jsonld}>

  <section class="hero bhero" id="top">
    <div class="hero__in">
      <h1 class="bwall" aria-label="tsam.blog" style={wall}><span class="vh">tsam.</span><Fit class="bwall__a" word="Bl" swell /><Fit class="bwall__b" word="|g" hero swell /></h1>
      <div class="hero__foot">
        <p class="hero__lead">起業家に向けた<wbr>チップス、<wbr>コラムなど。</p>
        <p class="tag hero__place"><b>{posts.length} articles</b><span>{firstYear}–{lastYear}</span></p>
        <a class="tag hero__next" href="#posts"><b>Latest</b><Go dir="s" /></a>
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="posts" data-iris>
    <div class="sec__head">
      <p class="tag sec__round"><b>Latest</b></p>
      <span class="record__count">{posts.length}本</span>
      <h2><span class="sec__ja">最新の記事</span> <Fit word="P|sts" swell /></h2>
    </div>
    <PostList items={latest} excerpt wide />
    <a class="ball" href="/archives"><span class="ball__t">すべての記事を見る<small>{posts.length}本</small></span><Go class="ball__go" /></a>
  </section>

  <section class="sec" id="topics" data-iris>
    <div class="sec__head">
      <p class="tag sec__round"><b>{usedTags.length} topics</b></p>
      <h2><span class="sec__ja">タグ</span> <Fit word="T|pics" swell /></h2>
    </div>
    <!-- タグの壁。語は極細で待っていて、指した語（指す仕組みの無い画面では、画面のまんなかを通っている語）だけが太る -->
    <ul class="twall">
      {usedTags.map((t, i) => (
        <li data-focus>
          <a href={`/tags/${t.slug}`}>
            <span class="twall__tag"><b>{no(i)}</b><span class="twall__ja">{t.ja}</span><small>{t.posts.length}本</small><Go /></span>
            <Fit word={t.en} seat={false} class="twall__word" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Author />

</Base>
