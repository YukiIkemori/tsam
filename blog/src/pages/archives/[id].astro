---
import Base from '../../layouts/Base.astro';
import O from '@www/components/O.astro';
import Word from '../../components/Word.astro';
import { fitStyle } from '@www/lib/fit';
import PostList from '../../components/PostList.astro';
import Author from '../../components/Author.astro';
import { site, author, org } from '../../data/site';
import { posts, related, neighbors, abs } from '../../lib/posts';
import { textbookName } from '../../lib/textbook';

// 記事の頁。URL は /archives/<番号>（旧ブログのまま）。
// 頭の大きな字はタグの英語の名前で、その o に輪が座る。読み進めるあいだ輪は左端の線を降りていき、
// 読み終わりの「Next round」（関連記事）の o に着く。
export function getStaticPaths() {
  return posts.map((p) => ({ params: { id: String(p.id) }, props: { p } }));
}
const { p } = Astro.props;
const tag = p.tags[0];
const word = tag?.en ?? 'Bl|g';
const next = related(p);
const { newer, older } = neighbors(p);
const updated = p.modified.slice(0, 10) > p.date.slice(0, 10) ? p.modified.slice(0, 10).replaceAll('-', '.') : null;
const url = abs(p.url);
const share = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(p.title)}`;

// 構造化データ。本文に無い事実は書かない。Review・FAQPage などは使わない。
// 寄稿の記事は、書き手を代表本人にしない（会社の名前で出す）。
const orgNode = { '@type': 'Organization', '@id': org.id, name: org.name, url: org.url, logo: { '@type': 'ImageObject', url: org.logo } };
const who = p.byOrg
  ? { '@type': 'Organization', '@id': org.id, name: org.name, url: org.url }
  : {
      '@type': 'Person',
      '@id': author.id,
      name: author.name,
      alternateName: author.latin,
      url: author.url,
      jobTitle: author.role.replace(`${org.name} `, ''),
      worksFor: { '@id': org.id },
      description: author.bio.join(''),
      sameAs: site.social.map((s) => s.href),
    };
const images = [...(p.og ? [p.og] : []), ...p.images].map(abs);
const image = images.length ? images : [abs('/ogp.jpg')];
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#article`,
      mainEntityOfPage: { '@id': url },
      url,
      headline: p.title,
      description: p.description,
      datePublished: p.date,
      dateModified: p.modified,
      inLanguage: 'ja',
      author: who,
      publisher: orgNode,
      copyrightHolder: { '@id': p.byOrg ? org.id : author.id },
      copyrightYear: Number(p.year),
      image,
      thumbnailUrl: image[0],
      wordCount: p.chars,
      timeRequired: `PT${p.minutes}M`,
      isAccessibleForFree: true,
      ...(tag ? { articleSection: tag.ja, keywords: p.tags.map((t) => t.ja) } : {}),
      ...(p.toc.length ? { hasPart: p.toc.map((h) => ({ '@type': 'WebPageElement', name: h.text, url: `${url}#${h.id}` })) } : {}),
      isPartOf: { '@type': 'Blog', '@id': `${site.url}/#blog`, name: site.name, url: `${site.url}/` },
    },
    {
      '@type': 'WebPage',
      '@id': url,
      url,
      name: p.title,
      description: p.description,
      inLanguage: 'ja',
      datePublished: p.date,
      dateModified: p.modified,
      primaryImageOfPage: { '@type': 'ImageObject', url: image[0] },
      breadcrumb: { '@id': `${url}#breadcrumb` },
      mainEntity: { '@id': `${url}#article` },
      relatedLink: next.map((q) => abs(q.url)),
      isPartOf: { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: `${site.url}/`, publisher: { '@id': org.id } },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.name, item: `${site.url}/` },
        ...(tag ? [{ '@type': 'ListItem', position: 2, name: tag.ja, item: `${site.url}/tags/${tag.slug}` }] : []),
        { '@type': 'ListItem', position: tag ? 3 : 2, name: p.title, item: url },
      ],
    },
  ],
};
---
<Base title={p.title} description={p.description} path={p.url} jsonld={jsonld} image={p.og} article={{ published: p.date, modified: p.modified, section: tag?.ja }} tweet={p.hasTweet}>
  <article class="post">
    <header class="post__head">
      <p class="post__word display fit" style={fitStyle(word)} data-swell>
        {tag ? <a href={`/tags/${tag.slug}`} aria-label={`${tag.ja}の記事一覧`}><Word word={word} /></a> : <a href="/" aria-label="tsam.blog トップへ"><Word word={word} /></a>}
      </p>
      <div class="post__bar">
        <p class="tag"><b><time datetime={p.date}>{p.ymd}</time></b>{p.tags.map((t) => <span>{t.ja}</span>)}</p>
        {updated && <p class="tag post__upd"><time datetime={p.modified}>{updated}</time><span>更新</span></p>}
      </div>
      <h1 class="post__title">{p.title}</h1>
    </header>

    <div class="split post__cols">
      <aside class="post__side">
        <p class="post__by"><small>書いた人</small>{p.byOrg ? org.name : <a href="#author">{author.name}</a>}</p>
        {p.toc.length > 0 && (
          <details class="toc">
            <summary>目次</summary>
            <ol>
              {p.toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
            </ol>
          </details>
        )}
      </aside>
      <div class="post__main">
        <div class="entry" set:html={p.html} />
        {p.textbook && (
          <aside class="post__book">
            <p class="tag"><b>Textbook</b><span>教科書</span></p>
            <p>この話題は、教科書『{textbookName}』にまとめてあります。</p>
            <a class="more" href={p.textbook.url}>{p.textbook.title}<span aria-hidden="true">↗</span></a>
          </aside>
        )}
        <p class="post__end">
          <a class="more" href={share} rel="noopener">X で共有する<span aria-hidden="true">↗</span></a>
          {tag && <a class="more" href={`/tags/${tag.slug}`}>「{tag.ja}」の記事<small>{posts.filter((q) => q.tags.includes(tag)).length}本</small><span aria-hidden="true">→</span></a>}
        </p>
        <nav class="post__end post__seq" aria-label="前後の記事">
          {older && <a class="more" href={older.url} rel="prev"><small>ひとつ前の記事</small>{older.title}<span aria-hidden="true">←</span></a>}
          {newer && <a class="more" href={newer.url} rel="next"><small>ひとつ後の記事</small>{newer.title}<span aria-hidden="true">→</span></a>}
        </nav>
      </div>
    </div>
  </article>

  <section class="sec sec--paper" id="next">
    <div class="sec__head">
      <p class="tag sec__round"><b>Related</b></p>
      <h2><span class="sec__ja">関連記事</span> <span class="display fit" style={fitStyle('Next round')} data-swell>Next r<O />und</span></h2>
    </div>
    <PostList items={next} excerpt />
    <a class="more more--all" href="/archives">すべての記事を見る<small>{posts.length}本</small><span aria-hidden="true">→</span></a>
  </section>

  <Author />
  {p.toc.length > 0 && <script is:inline>if (matchMedia('(min-width: 900px)').matches) document.querySelector('.toc').open = true;</script>}
</Base>
