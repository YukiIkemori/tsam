---
import Base from '../layouts/Base.astro';
import O from '../components/O.astro';
import { site } from '../data/site';
import { all, years, firstYear, lastYear } from '../data/activities';
import { inline } from '../scripts/inline';

// 活動の記録。旧サイトでトップに並んでいた News（2019〜）を、年ごとに全部出す頁。
// 選別はしない（オーナー 2026-11-26）。トップには新しい数件だけを出し、ここへつなぐ。
// 大きな字は「Record」。このサイトの見出しは o のある語にする決まり（輪の席が要る）。
const md = (d: string) => `${Number(d.slice(5, 7))}.${d.slice(8, 10)}`;
const title = '講演・審査員・メディア掲載の記録｜池森裕毅（株式会社tsam）';
const description = `株式会社tsam代表・池森裕毅の活動の記録。${firstYear}年から${lastYear}年までの講演、審査員、対談、就任、メディア掲載など全${all.length}件を、年ごとに新しい順でまとめています。講演や審査員のご依頼はお問い合わせフォームから。`;

// Event は使わない（startDate のほか場所などが要り、満たせないものが大半）。一覧の頁として宣言するだけにする。
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${site.url}/record#webpage`,
      url: `${site.url}/record`,
      name: title,
      description,
      inLanguage: 'ja',
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': `${site.url}/#ikemori` },
      publisher: { '@id': `${site.url}/#org` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '株式会社tsam', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: '活動の記録', item: `${site.url}/record` },
      ],
    },
  ],
};
---
<Base title={title} description={description} path="/record" jsonld={jsonld}>
  <article class="sec record">
    <header class="sec__head">
      <p class="tag sec__round"><b>{firstYear}–{lastYear}</b></p>
      <span class="record__count">{all.length}件</span>
      <h1><span class="sec__ja">活動の記録</span> <span class="display">Rec<O />rd</span></h1>
    </header>

    <p class="record__lead">講演、審査員、対談、就任、メディア掲載など、池森裕毅の活動を新しい順に並べています。</p>
    <nav class="jump" aria-label="年で飛ぶ">
      {years.map((y) => <a href={`#y${y.year}`}>{y.year}</a>)}
    </nav>

    {years.map((y) => (
      <section class="split split--year">
        <h2 class="yr" id={`y${y.year}`}><span class="display">{y.year}</span><small>{y.items.length}件</small></h2>
        <ol class="recent recent--year rv">
          {y.items.map((a) => (
            <li>
              <time datetime={a.date}>{md(a.date)}</time>
              <div>
                <p class="recent__title">{a.title}</p>
                <p class="recent__body" set:html={inline(a.body)} />
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <a class="back" href="/">← Home</a>
  </article>
</Base>
