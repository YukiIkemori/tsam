---
import Base from '../layouts/Base.astro';
import Fit from '../components/Fit.astro';
import Go from '../components/Go.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { years, books } from '../data/person';
import { all, recent } from '../data/activities';
import { pages as tbPages, NAME as tbName } from '../lib/startup';
import { inline } from '../scripts/inline';
import { measure, space, fitVars, THIN } from '../lib/fit';

// 最近の活動は、新しい順に頭の数件（site.recentCount）。全件は /record。
const ymd = (d: string) => d.replaceAll('-', '.');

// 教科書（/startup）への入口。文は教科書の目次の説明文にあるものだけ。
const textbook = { name: tbName, lead: 'スタートアップの起業を、問い一つにつき一頁で学べる教科書です。起業の基本、会社設立と資本政策、アイデア、検証、ビジネスモデル、成長、ピッチ、Exitまで。', total: tbPages.length + 2 };

// 表紙の字の壁（Mentor / to the next / round.）の比。書体から実測して CSS に渡す（組み方は global.css の「表紙：字の壁」）。
//   --ra・--rc … 極太の行の「高さ ÷ 幅」（Mentor、round.）
//   --rb1・--rb2 … 縦長の画面で四行に組むときの、to the（極細）と next（極太）の「高さ ÷ 幅」
//   --mnat … 横長の画面で、細い行「to the next」を幅いっぱいに組んだときの「高さ ÷ 幅」
//   --tb 細い行の天 ／ --lbn・--rbn 細い行の左右の空き ／ --sp 空白の送り（どれも em）
const TK = -0.011; // 細い行の字間（global.css の --tk と同じ値）
const mA = measure('Mentor', 900);
const mB = measure('to the next', THIN, TK);
const mB1 = measure('to the', THIN);
const mB2 = measure('next', 900);
const mC = measure('r|und.', 900);
const f4 = (n: number) => n.toFixed(4);
const wall = [
  `--ra:${f4((mA.top + mA.bot) / mA.ink)}`,
  `--rb1:${f4((mB1.top + mB1.bot) / mB1.ink)}`,
  `--rb2:${f4((mB2.top + mB2.bot) / mB2.ink)}`,
  `--rc:${f4((mC.top + mC.bot) / mC.ink)}`,
  `--mnat:${f4(mB.top / mB.ink)}`,
  `--tb:${f4(mB.top)}`,
  `--lbn:${f4(mB.lsb)}`,
  `--rbn:${f4(mB.rsb)}`,
  `--sp:${f4(space(THIN))}`,
].join(';');

// title は30全角以内、description は90〜125全角。どちらも頁に見えている事実だけで書く。
const title = '株式会社tsam（ツァム）｜スタートアップ支援・代表 池森裕毅';
const description =
  '株式会社tsam（ツァム）は起業家をサポートする会社です。代表の池森裕毅は信州大学特任教授。行政・地方自治体・大学機関と連携してスタートアップカリキュラムを提供しています。講演・審査員のご依頼はお問い合わせフォームから。';

// 構造化データ。**本文に無い事実は書かない**（経歴・役職・著書は、この頁に見えているものだけ）。
// Review・Event・SoftwareApplication は使わない（必須項目を満たせず、検索側でエラーだけが出続ける）。
const org = `${site.url}/#org`;
const person = `${site.url}/#ikemori`;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: `${site.url}/`,
      name: 'tsam',
      alternateName: '株式会社tsam',
      inLanguage: 'ja',
      publisher: { '@id': org },
    },
    {
      '@type': 'Organization',
      '@id': org,
      name: '株式会社tsam',
      alternateName: ['tsam', 'ツァム'],
      url: `${site.url}/`,
      logo: `${site.url}/apple-touch-icon.png`,
      image: `${site.url}/ogp.jpg`,
      slogan: site.tagline,
      description: 'tsamは起業家をサポートする会社です。起業における成功確率を少しでも高められるように、日々活動をしています。',
      foundingDate: '2019-02',
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        postalCode: '102-0074',
        addressRegion: '東京都',
        addressLocality: '千代田区',
        streetAddress: '九段南一丁目5番6号 りそな九段ビル5F',
        addressCountry: 'JP',
      },
      founder: { '@id': person },
      contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', email: site.email, availableLanguage: 'ja', url: `${site.url}/#contact` },
      sameAs: [site.blog],
    },
    {
      '@type': 'Person',
      '@id': person,
      name: '池森裕毅',
      alternateName: 'Yuki Ikemori',
      url: `${site.url}/#background`,
      jobTitle: ['株式会社tsam 代表取締役', '信州大学 特任教授'],
      description: '1980年生まれ、千葉県松戸市出身。東京理科大学中退後、起業家として活動開始。現在は、信州大学特任教授として教育現場に携わる傍ら、後進の起業家育成に従事。',
      birthDate: '1980',
      birthPlace: { '@type': 'Place', name: '千葉県松戸市' },
      worksFor: { '@id': org },
      affiliation: [
        { '@type': 'CollegeOrUniversity', name: '信州大学' },
        { '@type': 'CollegeOrUniversity', name: '情報経営イノベーション専門職大学' },
      ],
      sameAs: site.social.map((s) => s.href),
    },
    ...books.map((b) => ({
      '@type': 'Book',
      name: b.full,
      isbn: b.isbn,
      inLanguage: 'ja',
      datePublished: b.date,
      publisher: { '@type': 'Organization', name: b.publisher },
      // 一冊目は著者、二冊目は監修。監修に当たる型は無いので contributor に置く
      [b.role === '著' ? 'author' : 'contributor']: { '@id': person },
      url: b.href,
    })),
    {
      '@type': 'WebPage',
      '@id': `${site.url}/#webpage`,
      url: `${site.url}/`,
      name: title,
      description,
      inLanguage: 'ja',
      isPartOf: { '@id': `${site.url}/#website` },
      about: { '@id': org },
      primaryImageOfPage: `${site.url}/ogp.jpg`,
    },
  ],
};
---
<Base title={title} description={description} path="/" home jsonld={jsonld}>

  <section class="hero hero--wall" id="top">
    <div class="hero__in">
      <div class="hero__grid" style={wall}>
        <h1 class="wall" aria-label="Mentor to the next round.">
          <Fit class="wall__l wall__a" word="Mentor" swell />
          <span class="wall__l wall__b">
            <span class="fit wall__b1" style={fitVars('to the', THIN)}>to<i class="wall__rule"> </i>the</span>
            <Fit class="wall__next" word="next" swell />
          </span>
          <Fit class="wall__l wall__c" word="r|und." hero swell />
        </h1>
        <div class="hero__foot">
          <p class="hero__lead">株式会社tsamは<wbr>起業家をサポートする<wbr>会社です。</p>
          <p class="tag hero__place"><b>Tokyo</b><span>Since 2019</span></p>
          <a class="tag hero__next" href="#company"><b>Round 01</b><Go dir="s" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--paper" id="company" data-iris>
    <div class="sec__head">
      <p class="tag sec__round"><b>Round 01</b></p>
      <span class="lamps" aria-hidden="true"><i class="on"></i><i></i><i></i></span>
      <h2><span class="sec__ja">会社概要</span> <Fit word="C|mpany" swell /></h2>
    </div>
    <div class="company">
      <p class="statement"><span class="fill">一人ひとりが自分の力で<wbr>生きていけるように。<br>自分の力で自分が描いた世界を<wbr>創れるように。</span></p>
      <div class="company__text rv">
        <p>tsamは起業家をサポートする会社です。起業における成功確率を少しでも高められるように、日々活動をしています。</p>
        <p>一人でも多くの人が夢を叶えられたらなと、私達は思っています。</p>
      </div>
      <dl class="spec rv">
        <div><dt>会社名</dt><dd>株式会社tsam <small>(ツァム)</small></dd></div>
        <div><dt>代表取締役</dt><dd>池森裕毅</dd></div>
        <div><dt>設立</dt><dd>2019年2月</dd></div>
        <div><dt>資本金</dt><dd>100万円</dd></div>
        <div class="spec__wide"><dt>事業内容</dt><dd>インターネットコンサルティング事業<br>オンラインコミュニティ運営事業<br>オンラインWEBサービス運営事業</dd></div>
        <div class="spec__wide"><dt>本社所在地</dt><dd>東京都千代田区九段南一丁目5番6号<br>りそな九段ビル5F</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec" id="background" data-iris>
    <div class="sec__head">
      <p class="tag sec__round"><b>Round 02</b></p>
      <span class="lamps" aria-hidden="true"><i class="on"></i><i class="on"></i><i></i></span>
      <h2><span class="sec__ja">代表の経歴</span> <Fit word="Backgr|und" swell /></h2>
    </div>
    <div class="split">
      <div class="who rv">
        <p class="who__name">池森裕毅<span class="display display--thin" lang="en">Yuki Ikemori</span></p>
        <p class="who__role">代表取締役</p>
        <p>1980年生まれ、千葉県松戸市出身。東京理科大学中退後、起業家として活動開始。</p>
        <p>現在は、信州大学特任教授として教育現場に携わる傍ら、後進の起業家育成に従事。</p>
      </div>
      <ol class="years">
        {years.map(([y, t]) => (
          <li class="rv"><span class="years__y display">{y}</span><p>{t}</p></li>
        ))}
      </ol>
    </div>

    <div class="split split--sub" id="books">
      <h3 class="sub rv"><Fit word="Books" w={THIN} /><small>著書</small></h3>
      <ul class="books">
        {books.map((b) => (
          <li class="rv">
            <p class="books__meta">{b.date.slice(0, 4)} ／ {b.publisher}</p>
            <p class="books__title">{b.title}<small>{b.sub}</small></p>
            <p class="books__body">{b.body}</p>
            <a class="more" href={b.href} rel="noopener">Amazonで見る<Go dir="ne" /></a>
          </li>
        ))}
      </ul>
    </div>

    <div class="split split--sub" id="textbook">
      <h3 class="sub rv"><Fit word="Textbook" w={THIN} /><small>教科書</small></h3>
      <div class="tbdoor rv">
        <p class="tbdoor__title">{textbook.name}</p>
        <p>{textbook.lead}</p>
        <a class="more" href="/startup">教科書を読む<small>全{textbook.total}頁</small><Go /></a>
      </div>
    </div>

    <div class="split split--sub" id="recent">
      <h3 class="sub rv"><Fit word="Recent" w={THIN} /><small>最近の活動</small></h3>
      <div>
      <ol class="recent">
        {recent.map((a) => (
          <li class="rv">
            <time datetime={a.date}>{ymd(a.date)}</time>
            <div>
              <p class="recent__title">{a.title}</p>
              <p class="recent__body" set:html={inline(a.body)} />
            </div>
          </li>
        ))}
      </ol>
      <a class="more more--all" href="/record">すべての活動を見る<small>{all.length}件</small><Go /></a>
      </div>
    </div>
  </section>

  <section class="sec sec--dark" id="contact" data-iris>
    <div class="sec__head">
      <p class="tag sec__round"><b>Round 03</b></p>
      <span class="lamps" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i></span>
      <h2><span class="sec__ja">お問い合わせ</span> <Fit word="C|ntact" swell /></h2>
    </div>
    <div class="split">
      <div class="who rv">
        <p>講演や審査員のご依頼やコンサルティングのご希望など、お気軽にどうぞ。</p>
        <p class="who__mail"><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <ContactForm />
    </div>
  </section>

  <section class="door" id="blog" data-iris>
    <a class="door__link" href={site.blog} aria-label="Blog（blog.tsam.co.jp）">
      <span class="door__head"><span class="tag"><b>Next round</b><span>ブログ</span></span><Go dir="ne" class="door__go" /></span>
      <Fit word="Bl|g" swell />
    </a>
    <p class="door__ja">スタートアップ概論、投資家視点、ノウハウ、コラム。<span>blog.tsam.co.jp</span></p>
  </section>

</Base>
