---
import Base from '../../layouts/Base.astro';
import O from '../../components/O.astro';
import Word from '../../components/Word.astro';
import Lamps from '../../components/startup/Lamps.astro';
import Rows from '../../components/startup/Rows.astro';
import About from '../../components/startup/About.astro';
import '../../styles/startup.css';
import { site } from '../../data/site';
import { person, org } from '../../data/person';
import { pages, rounds, inRound, index, glossary, no, jaDate, NAME, BASE, PUBLISHED } from '../../lib/startup';

// 教科書の目次。大きな字は「Textbook」。区分は八つで、札は Round 01〜08（公式の節の札と同じ言い方）。
// 区分ごとの大きな字（Intro・Money・Concept…）は src/lib/startup.ts の rounds。
const url = `${site.url}${BASE}`;
const total = pages.length + 2; // 各頁＋目次＋用語集
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#webpage`,
      url,
      name: index.title,
      headline: index.h1,
      description: index.desc,
      inLanguage: 'ja',
      datePublished: PUBLISHED,
      dateModified: index.mod,
      isPartOf: { '@id': `${site.url}/#website` },
      author: { '@type': 'Person', '@id': person.id, name: person.name, url: person.url },
      publisher: { '@type': 'Organization', '@id': org.id, name: org.name, url: org.url },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: pages.length + 1,
        itemListElement: [
          ...pages.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.h1, url: `${site.url}${p.url}` })),
          { '@type': 'ListItem', position: pages.length + 1, name: glossary.h1, url: `${site.url}${glossary.url}` },
        ],
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '株式会社tsam', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: NAME, item: url },
      ],
    },
  ],
};
---
<Base title={index.title} description={index.desc} path={BASE} jsonld={jsonld} image={`${BASE}/og/index.jpg`} imageAlt={`${NAME}。起業の教科書`}>

  <section class="hero tb-hero" id="top">
    <h1 class="tb-hero__h1"><span class="tb-hero__ja">{index.h1}</span> <span class="display tb-hero__word">Textb<O hero />ok</span></h1>
    <div class="hero__foot">
      <p class="hero__lead">起業を、問い一つにつき一頁で。</p>
      <p class="tag"><b>全{total}頁</b><span>Round 01–08</span></p>
      <a class="tag hero__next" href="#r1"><b>Round 01</b><span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="sec sec--paper tb-pre" id="foreword">
    <div class="split">
      <h2 class="sub rv"><span class="display">Foreword</span><small>はじめに</small></h2>
      <div>
        <div class="tb-pre__text rv" set:html={index.html} />
        <p class="tb-by"><a href="#author">{person.name}</a>（信州大学 特任教授）　<time datetime={index.mod}>{jaDate(index.mod)} 更新</time></p>
        <nav class="jump tb-jump" aria-label="区分へ飛ぶ">
          {rounds.map((r) => <a href={`#r${r.n}`}><small>{no(r.n)}</small>{r.en.replace('|', 'o')}</a>)}
          <a href={glossary.url}><small>A–Z</small>Glossary</a>
        </nav>
      </div>
    </div>
  </section>

  {rounds.map((r, i) => (
    <section class:list={['sec', 'tb-round', { 'sec--paper': i % 2 === 1 }]} id={`r${r.n}`}>
      <div class="sec__head">
        <p class="tag sec__round"><b>Round {no(r.n)}</b></p>
        <Lamps n={r.n} />
        <h2><span class="sec__ja">{r.ja}</span> <span class="display"><Word word={r.en} /></span></h2>
      </div>
      <div class="split">
        <div class="tb-who rv">
          <p>{r.who}</p>
          <p class="tag"><b>{inRound(r).length}頁</b></p>
        </div>
        <Rows items={inRound(r)} />
      </div>
    </section>
  ))}

  <section class="door tb-door" id="glossary">
    <p class="tag"><b>A–Z</b><span>用語集</span></p>
    <a class="door__link" href={glossary.url} aria-label={glossary.h1}>
      <span class="display">Gl<O />ssary</span><span class="door__arrow" aria-hidden="true">→</span>
    </a>
    <p class="door__ja">この教科書に出てくる言葉を、一行ずつ。<span>{glossary.terms.length}語</span></p>
  </section>

  <About />
</Base>
