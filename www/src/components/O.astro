---
// 見出しの「o」。このサイトの装置はこれ一つ（太さの試作）。
// 「Mentor to the next round.」の round の o が、メンター。コーラルの o が一つだけ、読んでいる見出しに座り、
// 座った見出しだけが極細（200）から極太（800）に膨らむ（動かしているのは src/scripts/ring.js）。
// o は本物の字のまま。色と太さを変えているだけなので、読み上げも字詰めもそのまま。
// まわりの目盛り（.dial）は座っているあいだだけ出る、ラウンドの時計。hero のときは同心の目盛りも重ねる。
const { hero = false } = Astro.props;
const rings = [2.3, 3.9, 6.4, 10.2, 16];
---
<span class="o" data-slot>o<i class="dial" aria-hidden="true"></i>{hero && (
  <i class="rings" aria-hidden="true">{rings.map((d, i) => <i style={`--d:${d}em;--t:${70 + i * 26}s`} class:list={[{ rev: i % 2 === 1, tick: i === 1 || i === 3 }]}></i>)}</i>
)}</span>
