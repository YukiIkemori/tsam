---
import '@fontsource-variable/jost/wght.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import jost from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';

const { title, description = site.description, path = '/', home = false, jsonld, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const og = new URL('/ogp.jpg', site.url).href;
const h = (id: string) => (home ? `#${id}` : `/#${id}`);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}>
{!noindex && <link rel="canonical" href={canonical}>}
<link rel="preload" href={jost} as="font" type="font/woff2" crossorigin>
<meta name="theme-color" content="#f0f0ee">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:site_name" content="tsam">
<meta property="og:type" content="website">
<meta property="og:locale" content="ja_JP">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Mentor to the next round. の文字。round の o がコーラル色の輪になっている">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={og}>
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@300;400;500&display=swap">
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
<script is:inline>document.documentElement.classList.add('js');</script>
{site.ga && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga}`}></script>}
{site.ga && <script is:inline define:vars={{ ga: site.ga }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',ga);</script>}
</head>
<body>
<header class="top">
  <a class="logo" href="/" aria-label="tsam トップへ"><Logo /></a>
  <nav class="nav" aria-label="メニュー">
    <a href={h('company')}>Company</a>
    <a href={h('background')}>Background</a>
    <a href={h('contact')}>Contact</a>
    <a href={site.blog}>Blog<span aria-hidden="true">↗</span></a>
  </nav>
</header>
<main>
  <slot />
</main>
<footer class="foot">
  <a class="logo" href="/" aria-label="tsam トップへ"><Logo /></a>
  <ul class="foot__links">
    {site.social.map((s) => <li><a href={s.href} rel="noopener">{s.label}<span aria-hidden="true">↗</span></a></li>)}
    <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
  </ul>
  <p class="foot__copy">© {year} 株式会社tsam</p>
</footer>
<i class="traveler" aria-hidden="true"></i>
<script>
  import '../scripts/ring.js';
  import '../scripts/reveal.js';
</script>
</body>
</html>
